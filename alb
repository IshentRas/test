## 3. UI snippet (portal)

```javascript
async function openCoderApp(wsId, name, slug, planeId) {
  const q = new URLSearchParams({ format: "json" });
  if (planeId) q.set("plane", planeId);
  const data = await api(
    `/v1/workspaces/${wsId}/coder-app/${encodeURIComponent(slug || "code-server")}?${q}`
  );
  if (!data?.url) throw new Error("no coder app url from middle");
  openCoderURLMaybeStripToken(data.url);
}

/** First navigation with token so Coder can set its app cookie; then replace to a clean URL. */
function openCoderURLMaybeStripToken(withTok) {
  let clean = withTok;
  try {
    const u = new URL(withTok);
    u.searchParams.delete("coder_session_token");
    clean = u.toString();
  } catch {
    /* keep withTok */
  }
  if (!String(withTok).includes("coder_session_token=")) {
    window.open(withTok, "_blank", "noopener,noreferrer");
    return;
  }
  // No noopener — we must call location.replace on the opened window.
  const w = window.open(withTok, "_blank");
  if (!w) throw new Error("popup blocked — allow popups to open workspace apps");
  const t0 = Date.now();
  const iv = setInterval(() => {
    if (w.closed) {
      clearInterval(iv);
      return;
    }
    if (Date.now() - t0 < 900) return; // let Set-Cookie land
    try {
      w.location.replace(clean);
      clearInterval(iv);
    } catch {
      /* retry until timeout */
    }
    if (Date.now() - t0 > 12000) clearInterval(iv);
  }, 200);
}
```

**Frontend checklist**

- Call middle with the user’s IdP **Bearer** token (`format=json`).
- If `url` has no `coder_session_token` → normal `window.open` (`noopener` OK).
- If it does → open **without** `noopener`, then `location.replace` to the stripped URL.
- Allow popups; handle blockers.
- Stripping is **portal-only**; middle does not return a separate `url_clean`.

