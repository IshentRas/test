## 5. Coder template

Verified template (`kubernetes_manifest` Deployment). Lab-specific values to change for EKS:

| Lab value | Change to |
| --- | --- |
| `image = "coder-ovl-ws:lab"`, `imagePullPolicy = "Never"` | your registry image, `IfNotPresent` |
| `arch = "arm64"` | `amd64` for x86 nodes |
| `internal_url` + `replace(...)` of `http://localhost:8080` | drop if pods can reach your `CODER_ACCESS_URL`; keep the pattern if pods need an internal URL |
| `smarter-devices/fuse` | the resource name your fuse device plugin registers |
| `overlay-userns-debug.json` | `overlay-userns.json` (no `setns`) unless you want `nsenter` debugging |
| code-server installed at startup from the internet | pre-installed in the image or a Coder module |

```hcl
terraform {
  required_providers {
    coder = {
      source = "coder/coder"
    }
    kubernetes = {
      source = "hashicorp/kubernetes"
    }
  }
}

provider "kubernetes" {}

variable "namespace" {
  type    = string
  default = "coder-ws"
}

data "coder_workspace" "me" {}
data "coder_workspace_owner" "me" {}

locals {
  name = "coder-${lower(data.coder_workspace_owner.me.name)}-${lower(data.coder_workspace.me.name)}"
  # Browser uses the port-forward (localhost:8080); pods reach Coder through the in-cluster Service.
  internal_url = "http://coder.coder.svc.cluster.local"
}

resource "coder_agent" "main" {
  os   = "linux"
  arch = "arm64"
  dir  = "/home/coder/workspace"

  startup_script = <<-EOT
    set -e
    if [ ! -x /tmp/code-server/bin/code-server ]; then
      curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone --prefix=/tmp/code-server >/tmp/code-server-install.log 2>&1
    fi
    /tmp/code-server/bin/code-server --auth none --port 13337 /home/coder/workspace >/tmp/code-server.log 2>&1 &
  EOT

  metadata {
    display_name = "Overlay mounted"
    key          = "overlay"
    script       = "grep -q ' /home/coder/workspace fuse' /proc/self/mountinfo && echo yes || echo NO"
    interval     = 10
    timeout      = 2
  }
}

resource "coder_app" "code_server" {
  agent_id     = coder_agent.main.id
  slug         = "code-server"
  display_name = "VS Code (browser)"
  url          = "http://localhost:13337/?folder=/home/coder/workspace"
  icon         = "/icon/code.svg"
  subdomain    = false
  share        = "owner"

  healthcheck {
    url       = "http://localhost:13337/healthz"
    interval  = 5
    threshold = 20
  }
}

resource "kubernetes_config_map_v1" "entrypoint" {
  metadata {
    name      = "${local.name}-entrypoint"
    namespace = var.namespace
  }
  data = {
    "entrypoint.sh" = file("${path.module}/entrypoint.sh")
  }
}

resource "kubernetes_persistent_volume_claim_v1" "data" {
  metadata {
    name      = "${local.name}-data"
    namespace = var.namespace
  }
  wait_until_bound = false
  spec {
    access_modes = ["ReadWriteOnce"]
    resources {
      requests = {
        storage = "2Gi"
      }
    }
  }
}

resource "kubernetes_manifest" "workspace" {
  count = data.coder_workspace.me.start_count

  # Deployment, not a bare Pod: the API server injects the service account token volume into a Pod's
  # spec.volumes, which kubernetes_manifest reports as "wrong final value type ... tuple required".
  manifest = {
    apiVersion = "apps/v1"
    kind       = "Deployment"
    metadata = {
      name      = local.name
      namespace = var.namespace
    }
    spec = {
      replicas = 1
      strategy = { type = "Recreate" }
      selector = { matchLabels = { "coder.workspace" = local.name } }
      template = {
        metadata = { labels = { "coder.workspace" = local.name } }
        spec     = local.pod_spec
      }
    }
  }
}

locals {
  pod_spec = {
    hostUsers = false
    securityContext = {
      runAsNonRoot = true
      runAsUser    = 1000
      runAsGroup   = 1000
      fsGroup      = 1000
      seccompProfile = {
        type             = "Localhost"
        localhostProfile = "overlay-userns-debug.json"
      }
    }
    containers = [{
      name            = "dev"
      image           = "coder-ovl-ws:lab"
      imagePullPolicy = "Never"
      command         = ["/opt/ws/entrypoint.sh"]
      env = [
        { name = "CODER_AGENT_TOKEN", value = coder_agent.main.token },
        { name = "CODER_AGENT_URL", value = local.internal_url },
        { name = "CODER_INIT_SCRIPT", value = replace(coder_agent.main.init_script, "http://localhost:8080", local.internal_url) },
      ]
      securityContext = {
        allowPrivilegeEscalation = false
        capabilities = {
          drop = ["ALL"]
        }
      }
      resources = {
        limits   = { "smarter-devices/fuse" = "1", cpu = "2", memory = "2Gi" }
        requests = { "smarter-devices/fuse" = "1", cpu = "250m", memory = "512Mi" }
      }
      volumeMounts = [
        { name = "data", mountPath = "/data" },
        { name = "entrypoint", mountPath = "/opt/ws" },
      ]
    }]
    volumes = [
      { name = "data", persistentVolumeClaim = { claimName = kubernetes_persistent_volume_claim_v1.data.metadata[0].name } },
      { name = "entrypoint", configMap = { name = kubernetes_config_map_v1.entrypoint.metadata[0].name, defaultMode = 493 } },
    ]
  }
}
```

`entrypoint.sh` sits next to `main.tf` in the template directory.

Workspace image used in the lab:

```dockerfile
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      fuse-overlayfs util-linux procps curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -u 1000 -m -s /bin/bash coder
USER 1000
WORKDIR /home/coder
```

