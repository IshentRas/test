## Appendix A: `ws-base`

Install at `/opt/ws/ws-base` (ConfigMap with `defaultMode: 0755`, or bake into the image). Needs `bash`, `fuse-overlayfs`, `util-linux`, `diffutils`, `findutils`, `coreutils` (all in `debian:bookworm-slim` + `fuse-overlayfs util-linux`).

```bash
#!/bin/bash
# ws-base: move the workspace overlay's lower dir between materialized commits.
#
#   ws-base mount                            pin (first start) + mount; outer nested namespace
#   ws-base serve                            rebase controller; outer nested namespace, background
#   ws-base status | list                    read-only, from any terminal
#   ws-base check <ref>                      files whose upstream changed under your edits
#   ws-base use <sha|latest|tag/NAME> [--force]
#   ws-base back [--force]                   return to the previous base
#
# Layout (reconciler export root and ws-publish scratch root):
#   $WS_GIT_ROOT/commits/<sha>/  CURRENT_SHA  tags/<name> -> ../commits/<sha>
#   $WS_SCRATCH/upper/  work/  .base_commit_sha  .base_history
set -uo pipefail

GIT_ROOT=${WS_GIT_ROOT:-/git-backend}
SCRATCH=${WS_SCRATCH:-/data/overlay}
MERGED=${WS_MERGED:-/home/coder/workspace}
CTL=${WS_BASE_CTL:-/tmp/ws-base}
U=$SCRATCH/upper W=$SCRATCH/work
BASE_FILE=$SCRATCH/.base_commit_sha HIST=$SCRATCH/.base_history

err() { echo "ws-base: $*" >&2; return 1; }

current_base() { tr -d '[:space:]' < "$BASE_FILE" 2>/dev/null; }
latest_sha() { tr -d '[:space:]' < "$GIT_ROOT/CURRENT_SHA" 2>/dev/null; }

resolve() {
  local ref=$1 sha name
  local -a hits
  case $ref in
    latest)
      sha=$(latest_sha) ;;
    tag/*)
      name=${ref#tag/}
      case $name in ""|*..*|/*|*[!A-Za-z0-9._/-]*) err "bad tag name: $name"; return ;; esac
      sha=$(readlink "$GIT_ROOT/tags/$name") || { err "no such tag: $name"; return; }
      sha=${sha##*/} ;;
    *)
      case $ref in ""|*[!0-9a-f]*) err "bad ref: $ref"; return ;; esac
      [ ${#ref} -ge 7 ] || { err "sha prefix too short: $ref"; return; }
      shopt -s nullglob
      hits=("$GIT_ROOT/commits/$ref"*)
      shopt -u nullglob
      [ ${#hits[@]} -eq 1 ] || { err "$ref matches ${#hits[@]} materialized commits"; return; }
      sha=${hits[0]##*/} ;;
  esac
  case $sha in ""|*[!0-9a-f]*) err "cannot resolve $ref"; return ;; esac
  [ -d "$GIT_ROOT/commits/$sha" ] || { err "$sha is not materialized on this node"; return; }
  echo "$sha"
}

lower_differs() {
  local a=$1/$3 b=$2/$3
  if [ -L "$a" ] || [ -L "$b" ]; then
    [ "$(readlink "$a" 2>/dev/null)" != "$(readlink "$b" 2>/dev/null)" ]
  elif [ -d "$a" ] || [ -d "$b" ]; then
    ! diff -rq --no-dereference "$a" "$b" >/dev/null 2>&1
  elif [ -e "$a" ] || [ -e "$b" ]; then
    ! cmp -s "$a" "$b"
  else
    return 1
  fi
}

# Upper entries that shadow a path whose content differs between two bases:
# after the switch the user's copy (or whiteout) silently hides the upstream change.
stale_paths() {
  local old=$GIT_ROOT/commits/$1 new=$GIT_ROOT/commits/$2 p name rel
  (cd "$U" && find . -mindepth 1 ! -type d -print0) | while IFS= read -r -d '' p; do
    p=${p#./} name=${p##*/}
    case $name in
      .wh..wh..opq) rel=$(dirname "$p") ;;
      .wh.*) rel=$(dirname "$p")/${name#.wh.}; rel=${rel#./} ;;
      *) rel=$p ;;
    esac
    lower_differs "$old" "$new" "$rel" || continue
    # Converged with upstream: deleted on both sides, or identical content.
    if [ -c "$U/$p" ] || [ "$name" != "${name#.wh.}" ]; then
      [ -e "$new/$rel" ] || [ -L "$new/$rel" ] || continue
    elif [ -f "$U/$p" ] && [ ! -L "$U/$p" ] && cmp -s "$U/$p" "$new/$rel"; then
      continue
    fi
    printf '%s\n' "$rel"
  done | sort -u
}

# squash_to_root: the reconciler's files are owned by host root, which is unmapped in the nested
# namespace (shows as nobody); without it copy-up fails with EACCES/EOVERFLOW.
mount_overlay() {
  fuse-overlayfs -o "lowerdir=$GIT_ROOT/commits/$1,upperdir=$U,workdir=$W,squash_to_root" "$MERGED" 2> >(grep -v lazytime >&2)
}

write_base() {
  printf '%s\n' "$1" > "$BASE_FILE.tmp" && mv "$BASE_FILE.tmp" "$BASE_FILE"
}

do_mount() {
  local sha
  mkdir -p "$U" "$W" "$MERGED"
  if [ -z "$(current_base)" ]; then
    sha=$(resolve "${WS_BASE_REF:-latest}") || return
    write_base "$sha"
  fi
  sha=$(current_base)
  [ -d "$GIT_ROOT/commits/$sha" ] || { err "pinned base $sha is not materialized on this node"; return; }
  mount_overlay "$sha"
}

switch_to() {
  local cmd=$1 target=$2 force=$3 cur stale
  cur=$(current_base)
  [ "$target" != "$cur" ] || { echo "already on $cur"; return 0; }
  stale=$(stale_paths "$cur" "$target")
  if [ -n "$stale" ] && [ "$force" != force ]; then
    echo "refused: upstream changed these paths between ${cur:0:12} and ${target:0:12},"
    echo "and your copy would hide that change (re-run with --force to keep yours):"
    printf '%s\n' "$stale" | sed 's/^/  /'
    return 0
  fi
  if ! umount -l "$MERGED"; then echo "failed: could not unmount $MERGED"; return 0; fi
  if ! mount_overlay "$target"; then
    mount_overlay "$cur" && echo "failed: mount on $target; restored $cur" \
      || echo "failed: mount on $target and restore of $cur; restart the workspace"
    return 0
  fi
  if [ "$cmd" = back ]; then sed -i '$d' "$HIST"; else echo "$cur" >> "$HIST"; fi
  write_base "$target"
  echo "rebased ${cur:0:12} -> ${target:0:12}"
  [ -z "$stale" ] || { echo "kept your copy of:"; printf '%s\n' "$stale" | sed 's/^/  /'; }
  echo "cd out and back into $MERGED (and reload the editor) to see the new base"
}

handle() {
  local cmd=$1 arg=$2 force=$3 target
  case $cmd in
    use)  target=$(resolve "$arg" 2>&1) || { echo "$target"; return 0; } ;;
    back) target=$(tail -n1 "$HIST" 2>/dev/null)
          [ -n "$target" ] || { echo "no previous base"; return 0; }
          [ -d "$GIT_ROOT/commits/$target" ] || { echo "previous base $target is no longer materialized"; return 0; } ;;
    *)    echo "unknown request: $cmd"; return 0 ;;
  esac
  switch_to "$cmd" "$target" "$force"
}

serve() {
  local id cmd arg force
  mkdir -p -m 0700 "$CTL"
  rm -f "$CTL/req"; mkfifo -m 0600 "$CTL/req"
  exec 3<> "$CTL/req"
  while read -r id cmd arg force <&3; do
    case $id in ""|*[!0-9.]*) continue ;; esac
    handle "$cmd" "$arg" "$force" > "$CTL/res.$id.tmp" 2>&1
    mv "$CTL/res.$id.tmp" "$CTL/res.$id"
  done
}

request() {
  local id=$$.$RANDOM i
  [ -p "$CTL/req" ] || err "controller not running ($CTL/req missing)" || return
  printf '%s %s %s %s\n' "$id" "$1" "${2:--}" "${3:--}" | timeout 5 tee "$CTL/req" >/dev/null \
    || { err "controller not responding"; return; }
  for i in $(seq 1 600); do
    [ -f "$CTL/res.$id" ] && { cat "$CTL/res.$id"; rm -f "$CTL/res.$id"; return 0; }
    sleep 0.1
  done
  err "timed out waiting for the controller"
}

status() {
  local cur latest n
  cur=$(current_base) latest=$(latest_sha)
  n=$( (cd "$U" && find . -mindepth 1 ! -type d) 2>/dev/null | wc -l)
  echo "base:    $cur"
  echo "latest:  $latest$([ "$cur" = "$latest" ] && echo "  (up to date)")"
  echo "back ->  $(tail -n1 "$HIST" 2>/dev/null || true)"
  echo "changes: $n entries in upper"
}

list() {
  local cur latest d s t
  cur=$(current_base) latest=$(latest_sha)
  for d in "$GIT_ROOT"/commits/*/; do
    s=$(basename "$d")
    case $s in *[!0-9a-f]*) continue ;; esac
    printf '%s %s%s\n' "$s" "$([ "$s" = "$cur" ] && echo '[base]')" "$([ "$s" = "$latest" ] && echo '[latest]')"
  done
  [ -d "$GIT_ROOT/tags" ] && (cd "$GIT_ROOT/tags" && find . -type l | sed 's|^\./||') | while read -r t; do
    printf 'tag/%s -> %s\n' "$t" "$(basename "$(readlink "$GIT_ROOT/tags/$t")")"
  done
}

force=-
[ "${3:-}" = --force ] || [ "${2:-}" = --force ] && force=force
case ${1:-} in
  mount)  do_mount ;;
  serve)  serve ;;
  status) status ;;
  list)   list ;;
  check)  t=$(resolve "${2:?ref}") && s=$(stale_paths "$(current_base)" "$t") \
            && { [ -n "$s" ] && printf '%s\n' "$s" || echo "no conflicts with $t"; } ;;
  use)    [ -n "${2:-}" ] && [ "$2" != --force ] || { err "usage: ws-base use <sha|latest|tag/NAME> [--force]"; exit 2; }
          request use "$2" "$force" ;;
  back)   request back - "$force" ;;
  *)      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
```
