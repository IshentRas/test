### 5.8 `ws_actions/handlers.py` (the server side: runs the commands)

This is where the menu items become commands. Things it takes care of:

- **Fixed commands, no shell.** Each action maps to a fixed argv list; the only user input is the share tag for Promote, checked against `ws/<user>/<yyyymmdd-hhmmss>`.
- **Token never in argv or output.** `ws-publish` reads `GITLAB_TOKEN` from the environment itself. Its git errors print the push URL with the token inside (`https://oauth2:<token>@…`); the output is redacted before it reaches the browser.
- **One action at a time.** A second click while one runs gets "another workspace action is still running".
- **Timeouts.** 10 minutes for `ws-publish` (clone + push), 2 minutes for `ws-base`.
- **`ws-base` exit codes.** `ws-base use/back` answer `refused: …` or `failed: …` with exit code 0, so success means "output starts with `rebased` or `already on`".
- **Dry run.** With `WS_ACTIONS_DRY_RUN=1` it only shows the command it would run.

```bash
cat > /home/coder/dev/ws_actions/ws_actions/handlers.py <<'EOF'
import asyncio
import json
import os
import re
from asyncio.subprocess import DEVNULL, PIPE, STDOUT

import tornado
from jupyter_server.base.handlers import APIHandler
from jupyter_server.utils import url_path_join

WS_PUBLISH = os.environ.get("WS_PUBLISH_BIN", "ws-publish")
WS_BASE = os.environ.get("WS_BASE_BIN", "ws-base")
# Show the command that would run instead of running it (UI testing without the backend).
DRY_RUN = os.environ.get("WS_ACTIONS_DRY_RUN", "") == "1"
SHARE_TAG_RE = re.compile(r"^ws/[A-Za-z0-9._-]{1,64}/[0-9]{8}-[0-9]{6}$")
URL_CREDENTIALS_RE = re.compile(r"(https?://)[^/@\s]+@")
BASE_SWITCHED_RE = re.compile(r"^(rebased|already on)")
MAX_OUTPUT = 8000

_lock = asyncio.Lock()


def _force(body):
    return ["--force"] if body.get("force") is True else []


def _promote(body):
    tag = str(body.get("from_tag") or "").strip()
    if not tag:
        return [WS_PUBLISH, "promote"]
    if not SHARE_TAG_RE.match(tag):
        raise tornado.web.HTTPError(400, "invalid share tag (expected ws/<user>/<yyyymmdd-hhmmss>)")
    return [WS_PUBLISH, "promote", "-from-tag", tag]


# action -> (argv builder, timeout in seconds). ws-publish clones and pushes, so it gets longer.
ACTIONS = {
    "status": (lambda b: [WS_BASE, "status"], 30),
    "share": (lambda b: [WS_PUBLISH, "share"], 600),
    "promote": (_promote, 600),
    "check": (lambda b: [WS_BASE, "check", "latest"], 120),
    "rebase": (lambda b: [WS_BASE, "use", "latest", *_force(b)], 120),
    "back": (lambda b: [WS_BASE, "back", *_force(b)], 120),
}


def _env():
    env = os.environ.copy()
    # ws-publish defaults to /scratch; the overlay workspace keeps upper/ and .base_commit_sha here.
    env.setdefault("SCRATCH_ROOT", env.get("WS_SCRATCH", "/data/overlay"))
    return env


def _redact(text):
    token = os.environ.get("GITLAB_TOKEN", "")
    if token:
        text = text.replace(token, "***")
    return URL_CREDENTIALS_RE.sub(r"\1***@", text)


async def _run(argv, timeout):
    try:
        proc = await asyncio.create_subprocess_exec(
            *argv, stdin=DEVNULL, stdout=PIPE, stderr=STDOUT, env=_env(), cwd=os.path.expanduser("~")
        )
    except FileNotFoundError:
        return 127, f"{argv[0]}: command not found (set WS_PUBLISH_BIN / WS_BASE_BIN or fix PATH)"
    try:
        out, _ = await asyncio.wait_for(proc.communicate(), timeout)
    except asyncio.TimeoutError:
        proc.kill()
        await proc.wait()
        return 124, f"{argv[0]} timed out after {timeout}s"
    return proc.returncode, out.decode(errors="replace")


class ActionHandler(APIHandler):
    @tornado.web.authenticated
    async def post(self, action):
        build, timeout = ACTIONS[action]
        argv = build(self.get_json_body() or {})
        if DRY_RUN:
            code, output = 0, "(dry run) would run: " + " ".join(argv)
        else:
            if _lock.locked():
                raise tornado.web.HTTPError(409, "another workspace action is still running")
            async with _lock:
                code, output = await _run(argv, timeout)
        output = _redact(output).strip()[-MAX_OUTPUT:]
        ok = code == 0
        # ws-base answers "refused: ..." / "failed: ..." with exit code 0.
        if action in ("rebase", "back") and not DRY_RUN:
            ok = ok and bool(BASE_SWITCHED_RE.match(output))
        self.log.info("ws_actions %s exit=%s ok=%s", action, code, ok)
        self.finish(json.dumps({"ok": ok, "output": output}))


def setup_handlers(web_app):
    base_url = web_app.settings["base_url"]
    actions = "|".join(ACTIONS)
    web_app.add_handlers(".*$", [
        (url_path_join(base_url, "ws-actions", "run", f"({actions})"), ActionHandler),
    ])
EOF
```

To add another action later: add one line to `ACTIONS` (name → argv + timeout), one command in `index.ts`, and one entry in `schema/plugin.json`.

### 5.9 `src/handler.ts` (calls the server with Jupyter's auth and XSRF handling)

```bash
cat > /home/coder/dev/ws_actions/src/handler.ts <<'EOF'
import { URLExt } from '@jupyterlab/coreutils';
import { ServerConnection } from '@jupyterlab/services';

/**
 * Calls this extension's server routes (/ws-actions/<endPoint>) with Jupyter's auth and
 * XSRF handling.
 */
export async function requestAPI<T>(endPoint = '', init: RequestInit = {}): Promise<T> {
  const settings = ServerConnection.makeSettings();
  const requestUrl = URLExt.join(settings.baseUrl, 'ws-actions', endPoint);
  let response: Response;
  try {
    response = await ServerConnection.makeRequest(requestUrl, init, settings);
  } catch (error) {
    throw new ServerConnection.NetworkError(error as TypeError);
  }
  let data: any = await response.text();
  if (data.length > 0) {
    try {
      data = JSON.parse(data);
    } catch {
      // not JSON
    }
  }
  if (!response.ok) {
    throw new ServerConnection.ResponseError(response, data.message || data);
  }
  return data;
}
EOF
```

### 5.10 `src/index.ts` (the button, the menu, the dialogs)

What it does:

- One toolbar button (custom "branches" icon) opens a dropdown; the same commands are in the **Workspace** top menu.
- Every action shows an in-progress notification that turns into the result, with a **Details** button that opens the full command output.
- **Update to latest** runs the conflict check first and changes the confirm button to a red **Update anyway** when there are conflicts.
- **Go back** offers **Go back anyway** if `ws-base` refuses.
- After a base switch it refreshes the file browser and reminds the user to reload open files and restart kernels (open handles keep the old view, see the overlay guide).

