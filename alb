### 6.3 Bounce Lambda

Go module with `github.com/aws/aws-lambda-go` and `github.com/aws/aws-sdk-go-v2`
(`config`, `aws/signer/v4`, `credentials/stscreds`, `service/sts`).

```go
// Package bounce is the plane-host cookie bounce, shaped as an ALB → Lambda target.
// It never mints anything: it proves its IAM identity to middle (signed
// sts:GetCallerIdentity), redeems the portal's one-time code, then answers the
// browser with a host-only coder_session_token cookie and a 302.
package bounce

import (
	"bytes"
	"context"
	"crypto/sha256"
	"encoding/base64"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"net/url"
	"os"
	"strings"
	"time"

	"github.com/aws/aws-lambda-go/events"
	"github.com/aws/aws-sdk-go-v2/aws"
	v4 "github.com/aws/aws-sdk-go-v2/aws/signer/v4"
	"github.com/aws/aws-sdk-go-v2/config"
	"github.com/aws/aws-sdk-go-v2/credentials/stscreds"
	"github.com/aws/aws-sdk-go-v2/service/sts"
)

const stsBody = "Action=GetCallerIdentity&Version=2011-06-15"

type Handler struct {
	MiddleURL    string // e.g. https://middle.example.com
	ServerID     string // audience; must match middle bounce.server_id
	Region       string // STS signing region (same endpoint middle replays to)
	CookieSecure bool
	Creds        aws.CredentialsProvider
	HTTP         *http.Client
}

// FromEnv reads MIDDLE_URL, MIDDLE_SERVER_ID, STS_REGION, COOKIE_SECURE and the
// optional BOUNCE_ASSUME_ROLE_ARN (local runs only; a real Lambda uses its execution role).
func FromEnv(ctx context.Context) (*Handler, error) {
	region := envOr("STS_REGION", "us-east-1")
	cfg, err := config.LoadDefaultConfig(ctx, config.WithRegion(region))
	if err != nil {
		return nil, err
	}
	creds := cfg.Credentials
	if role := os.Getenv("BOUNCE_ASSUME_ROLE_ARN"); role != "" {
		creds = aws.NewCredentialsCache(stscreds.NewAssumeRoleProvider(sts.NewFromConfig(cfg), role,
			func(o *stscreds.AssumeRoleOptions) { o.RoleSessionName = "bounce-local" }))
	}
	h := &Handler{
		MiddleURL:    strings.TrimRight(os.Getenv("MIDDLE_URL"), "/"),
		ServerID:     os.Getenv("MIDDLE_SERVER_ID"),
		Region:       region,
		CookieSecure: envOr("COOKIE_SECURE", "true") != "false",
		Creds:        creds,
		HTTP:         &http.Client{Timeout: 8 * time.Second},
	}
	if h.MiddleURL == "" || h.ServerID == "" {
		return nil, fmt.Errorf("MIDDLE_URL and MIDDLE_SERVER_ID are required")
	}
	return h, nil
}

// Handle serves both /_portal/bounce and /_portal/done. With multi-value headers enabled on the
// target group the ALB only accepts multiValueHeaders in the response, so the reply mirrors the
// request's format.
func (h *Handler) Handle(ctx context.Context, ev events.ALBTargetGroupRequest) (events.ALBTargetGroupResponse, error) {
	var res events.ALBTargetGroupResponse
	var err error
	if strings.HasSuffix(ev.Path, "/done") {
		res, err = h.done(ctx, ev)
	} else {
		res, err = h.bounce(ctx, ev)
	}
	if len(ev.MultiValueHeaders) > 0 && res.Headers != nil {
		res.MultiValueHeaders = map[string][]string{}
		for k, v := range res.Headers {
			res.MultiValueHeaders[k] = []string{v}
		}
		res.Headers = nil
	}
	return res, err
}

func (h *Handler) bounce(ctx context.Context, ev events.ALBTargetGroupRequest) (events.ALBTargetGroupResponse, error) {
	code := codeFromEvent(ev)
	host := header(ev, "host")
	if code == "" {
		return page(http.StatusBadRequest, "Missing code."), nil
	}
	proof, err := h.signedIdentity(ctx, "redeem", code)
	if err != nil {
		log.Printf("bounce: sign identity: %v", err)
		return page(http.StatusInternalServerError, "Bounce misconfigured."), nil
	}
	body, _ := json.Marshal(map[string]any{"code": code, "host": host, "iam": proof})
	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, h.MiddleURL+"/internal/bounce/redeem", bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json")
	res, err := h.HTTP.Do(req)
	if err != nil {
		log.Printf("bounce: redeem: %v", err)
		return page(http.StatusBadGateway, "Middle unreachable, retry from the portal."), nil
	}
	defer res.Body.Close()
	if res.StatusCode != http.StatusOK {
		msg, _ := io.ReadAll(io.LimitReader(res.Body, 512))
		log.Printf("bounce: redeem %d: %s", res.StatusCode, strings.TrimSpace(string(msg)))
		return page(http.StatusForbidden, "This link expired or was already used. Retry from the portal."), nil
	}
	var out struct {
		SessionToken string `json:"session_token"`
		RedirectPath string `json:"redirect_path"`
		MaxAge       int    `json:"max_age"`
	}
	if err := json.NewDecoder(res.Body).Decode(&out); err != nil || out.SessionToken == "" ||
		!strings.HasPrefix(out.RedirectPath, "/") || strings.HasPrefix(out.RedirectPath, "//") {
		return page(http.StatusBadGateway, "Unexpected middle response."), nil
	}
	cookie := (&http.Cookie{
		Name:     "coder_session_token",
		Value:    out.SessionToken,
		Path:     "/",
		MaxAge:   out.MaxAge,
		HttpOnly: true,
		Secure:   h.CookieSecure,
		SameSite: http.SameSiteLaxMode,
	}).String()
	return events.ALBTargetGroupResponse{
		StatusCode:        http.StatusFound,
		StatusDescription: "302 Found",
		Headers: map[string]string{
			"Location":        out.RedirectPath,
			"Set-Cookie":      cookie,
			"Cache-Control":   "no-store",
			"Referrer-Policy": "no-referrer",
		},
	}, nil
}

// done is where Coder lands after external auth (?redirect=/_portal/done). It asks middle to
// revoke the bounce token carried by the cookie, clears the cookie, and returns to the portal,
// so the consent session can't be reused for the Coder dashboard.
func (h *Handler) done(ctx context.Context, ev events.ALBTargetGroupRequest) (events.ALBTargetGroupResponse, error) {
	token := cookieValue(header(ev, "cookie"), "coder_session_token")
	proof, err := h.signedIdentity(ctx, "done", token)
	if err != nil {
		log.Printf("bounce done: sign identity: %v", err)
		return page(http.StatusInternalServerError, "Bounce misconfigured."), nil
	}
	body, _ := json.Marshal(map[string]any{"host": header(ev, "host"), "session_token": token, "iam": proof})
	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, h.MiddleURL+"/internal/bounce/done", bytes.NewReader(body))
	req.Header.Set("Content-Type", "application/json")
	clear := (&http.Cookie{
		Name: "coder_session_token", Value: "", Path: "/", MaxAge: -1,
		HttpOnly: true, Secure: h.CookieSecure, SameSite: http.SameSiteLaxMode,
	}).String()
	res, err := h.HTTP.Do(req)
	if err != nil {
		log.Printf("bounce done: %v", err)
		return withCookie(page(http.StatusBadGateway, "Linked, but middle was unreachable. Return to the portal."), clear), nil
	}
	defer res.Body.Close()
	var out struct {
		RedirectURL string `json:"redirect_url"`
		Revoked     bool   `json:"revoked"`
	}
	if res.StatusCode != http.StatusOK || json.NewDecoder(res.Body).Decode(&out) != nil {
		log.Printf("bounce done: middle status %d", res.StatusCode)
		return withCookie(page(http.StatusForbidden, "Linked. Return to the portal."), clear), nil
	}
	u, err := url.Parse(out.RedirectURL)
	if err != nil || (u.Scheme != "https" && u.Scheme != "http") || u.Host == "" {
		return withCookie(page(http.StatusOK, "Linked. Return to the portal."), clear), nil
	}
	q := u.Query()
	q.Set("linked", "1")
	u.RawQuery = q.Encode()
	log.Printf("bounce done: revoked=%v", out.Revoked)
	return events.ALBTargetGroupResponse{
		StatusCode:        http.StatusFound,
		StatusDescription: "302 Found",
		Headers: map[string]string{
			"Location":        u.String(),
			"Set-Cookie":      clear,
			"Cache-Control":   "no-store",
			"Referrer-Policy": "no-referrer",
		},
	}, nil
}

func withCookie(r events.ALBTargetGroupResponse, c string) events.ALBTargetGroupResponse {
	r.Headers["Set-Cookie"] = c
	return r
}

func cookieValue(raw, name string) string {
	if raw == "" {
		return ""
	}
	req := http.Request{Header: http.Header{"Cookie": {raw}}}
	if c, err := req.Cookie(name); err == nil {
		return c.Value
	}
	return ""
}

// signedIdentity builds (but does not send) an sts:GetCallerIdentity request signed with
// this function's role. X-Middle-Server-Id and X-Middle-Code-Sha256 (= sha256(action\nvalue))
// are signed so the proof is only valid for this middle, this action and this value.
func (h *Handler) signedIdentity(ctx context.Context, action, value string) (map[string]any, error) {
	creds, err := h.Creds.Retrieve(ctx)
	if err != nil {
		return nil, err
	}
	endpoint := fmt.Sprintf("https://sts.%s.amazonaws.com/", h.Region)
	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, strings.NewReader(stsBody))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded; charset=utf-8")
	req.Header.Set("X-Middle-Server-Id", h.ServerID)
	codeSum := sha256.Sum256([]byte(action + "\n" + value))
	req.Header.Set("X-Middle-Code-Sha256", hex.EncodeToString(codeSum[:]))
	bodySum := sha256.Sum256([]byte(stsBody))
	if err := v4.NewSigner().SignHTTP(ctx, creds, req, hex.EncodeToString(bodySum[:]), "sts", h.Region, time.Now()); err != nil {
		return nil, err
	}
	headers := map[string]string{}
	for k := range req.Header {
		headers[strings.ToLower(k)] = req.Header.Get(k)
	}
	return map[string]any{
		"headers": headers,
		"body":    base64.StdEncoding.EncodeToString([]byte(stsBody)),
	}, nil
}

// codeFromEvent accepts a form POST (preferred: keeps the code out of URLs and ALB
// access logs) or ?code= on GET.
func codeFromEvent(ev events.ALBTargetGroupRequest) string {
	if strings.EqualFold(ev.HTTPMethod, http.MethodPost) {
		body := ev.Body
		if ev.IsBase64Encoded {
			if b, err := base64.StdEncoding.DecodeString(body); err == nil {
				body = string(b)
			}
		}
		if v, err := url.ParseQuery(body); err == nil && v.Get("code") != "" {
			return v.Get("code")
		}
	}
	raw := ev.QueryStringParameters["code"] // ALB passes query values still percent-encoded
	if vs := ev.MultiValueQueryStringParameters["code"]; raw == "" && len(vs) > 0 {
		raw = vs[0]
	}
	if v, err := url.QueryUnescape(raw); err == nil {
		return v
	}
	return raw
}

// header reads single- or multi-value ALB headers. Without multi-value headers the ALB keeps only
// the last of repeated headers, which can drop cookies (HTTP/2 browsers may split them), so enable
// lambda.multi_value_headers.enabled on the target group.
func header(ev events.ALBTargetGroupRequest, name string) string {
	for k, v := range ev.Headers {
		if strings.EqualFold(k, name) {
			return v
		}
	}
	for k, vs := range ev.MultiValueHeaders {
		if strings.EqualFold(k, name) {
			if strings.EqualFold(name, "cookie") {
				return strings.Join(vs, "; ")
			}
			if len(vs) > 0 {
				return vs[0]
			}
		}
	}
	return ""
}

func page(status int, msg string) events.ALBTargetGroupResponse {
	return events.ALBTargetGroupResponse{
		StatusCode:        status,
		StatusDescription: fmt.Sprintf("%d %s", status, http.StatusText(status)),
		Headers:           map[string]string{"Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store"},
		Body:              msg + "\n",
	}
}

func envOr(k, def string) string {
	if v := os.Getenv(k); v != "" {
		return v
	}
	return def
}
```

