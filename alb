#### Redeem (IAM-authenticated)

```go
type iamProof struct {
	Headers map[string]string `json:"headers"`
	Body    string            `json:"body"` // base64 of the signed STS form body
}

const bounceConsentTTLSeconds = 300

// "bounce-a", not "middle-a-bounce": middle-a-* names are treated as the main key's legacy variants.
func bounceTokenName(planeID string) string { return "bounce-" + planeID }

// POST /internal/bounce/redeem  {code, host, iam}
// Caller auth is the IAM proof only (no user auth): the user is resolved from the code.
func (s *Service) handleBounceRedeem(w http.ResponseWriter, r *http.Request) {
	var in struct {
		Code string   `json:"code"`
		Host string   `json:"host"`
		IAM  iamProof `json:"iam"`
	}
	if err := json.NewDecoder(io.LimitReader(r.Body, 64<<10)).Decode(&in); err != nil || in.Code == "" {
		http.Error(w, "invalid request", http.StatusBadRequest)
		return
	}
	callerPlane, callerARN, err := s.verifyBounceCaller(r.Context(), in.IAM, "redeem", in.Code)
	if err != nil {
		log.Printf("bounce redeem rejected caller: %v", err)
		http.Error(w, "caller not trusted", http.StatusForbidden)
		return
	}
	rec, ok := s.Bounce.Consume(in.Code)
	if !ok {
		http.Error(w, "invalid or expired code", http.StatusUnauthorized)
		return
	}
	if rec.Plane != callerPlane {
		http.Error(w, "plane mismatch", http.StatusForbidden)
		return
	}
	p, err := s.plane(rec.Plane)
	if err != nil {
		http.Error(w, err.Error(), http.StatusBadRequest)
		return
	}
	host := in.Host
	if h, _, err := net.SplitHostPort(host); err == nil {
		host = h
	}
	if !strings.EqualFold(host, cookieHostForURL(p.URL)) {
		http.Error(w, "host mismatch", http.StatusForbidden)
		return
	}
	maxAge := s.Config.Bounce.CookieMaxAgeSeconds
	var tok string
	if rec.Purpose == "external-auth" {
		// Dedicated short-lived key: revoked at DonePath so the cookie can't be reused for
		// the Coder dashboard, without touching the user's main middle-<plane> key.
		maxAge = bounceConsentTTLSeconds
		tok, err = s.mintBounceToken(r.Context(), rec.Email, p, time.Duration(maxAge)*time.Second)
	} else {
		tok, err = s.ensureCoderTokenOnPlane(r.Context(), rec.Email, p.ID)
	}
	if err != nil {
		http.Error(w, err.Error(), http.StatusBadGateway)
		return
	}
	log.Printf("bounce redeem ok email=%s plane=%s purpose=%s caller=%s", rec.Email, p.ID, rec.Purpose, callerARN)
	writeJSON(w, http.StatusOK, map[string]any{
		"session_token": tok,
		"redirect_path": rec.Redirect,
		"max_age":       maxAge,
	})
}

func (s *Service) mintBounceToken(ctx context.Context, email string, p *Plane, lifetime time.Duration) (string, error) {
	user, err := p.Client.FindOrCreateUser(ctx, email)
	if err != nil {
		return "", err
	}
	return p.Client.EnsureReservedUserTokenLifetime(ctx, user.ID, bounceTokenName(p.ID), lifetime)
}
