```go
type BounceConfig struct {
	ServerID            string         `yaml:"server_id"`     // must match signed X-Middle-Server-Id
	STSEndpoint         string         `yaml:"sts_endpoint"`  // fixed; never taken from the caller
	Path                string         `yaml:"path"`          // bounce path on the plane host
	DonePath            string         `yaml:"done_path"`     // post-consent path on the plane host
	DoneRedirect        string         `yaml:"done_redirect"` // where /done sends the browser (portal)
	CodeTTLSeconds      int            `yaml:"code_ttl_seconds"`
	CookieMaxAgeSeconds int            `yaml:"cookie_max_age_seconds"`
	Callers             []BounceCaller `yaml:"callers"`
}

type BounceCaller struct {
	Plane     string `yaml:"plane"`
	AccountID string `yaml:"account_id"`
	RoleName  string `yaml:"role_name"`
	RoleID    string `yaml:"role_id"` // optional AROA… pin
}
```

Defaults applied at load: `path=/_portal/bounce`, `done_path=/_portal/done`,
`done_redirect=<first portal origin>/`, `sts_endpoint=https://sts.us-east-1.amazonaws.com/`,
`code_ttl_seconds=60`, `cookie_max_age_seconds=900`.

The SigV4 signature covers the `Host` header, so the Lambda's `STS_REGION` and middle's
`sts_endpoint` must point at the same regional endpoint.

#### Routes

```go
mux.Handle("POST /v1/bounce/start", svc.requireAuth(http.HandlerFunc(svc.handleBounceStart)))              // user (IdP JWT)
mux.HandleFunc("POST /internal/bounce/redeem", svc.handleBounceRedeem)                                     // IAM proof
mux.HandleFunc("POST /internal/bounce/done", svc.handleBounceDone)                                         // IAM proof
mux.Handle("GET /v1/external-auth/{id}", svc.requireAuth(http.HandlerFunc(svc.handleExternalAuthStatus)))  // user
mux.Handle("DELETE /v1/external-auth/{id}", svc.requireAuth(http.HandlerFunc(svc.handleExternalAuthDelete))) // user
```

Helpers assumed from the rest of middle: `requireAuth` validates the IdP JWT and puts the email in
the context (`emailFromCtx`); `s.plane(id)` returns the plane (default plane if empty);
`s.ensureCoderTokenOnPlane(ctx, email, plane)` returns the user's **main** `middle-<plane>` key
(cached; finds or creates the Coder user and re-mints if the cached key is invalid);
`cookieHostForURL(url)` returns the hostname of a plane URL; `writeJSON` writes a JSON response.

#### One-time codes

```go
type bounceCode struct {
	Email    string
	Plane    string
	Redirect string
	Purpose  string
	Exp      time.Time
}

// In-memory (single replica). Production: Redis/DynamoDB with TTL and an atomic
// get-and-delete so any replica can redeem exactly once.
type BounceStore struct {
	mu sync.Mutex
	m  map[string]bounceCode
}

func NewBounceStore() *BounceStore { return &BounceStore{m: map[string]bounceCode{}} }

func (b *BounceStore) Issue(rec bounceCode) (string, error) {
	raw := make([]byte, 32)
	if _, err := rand.Read(raw); err != nil {
		return "", err
	}
	code := base64.RawURLEncoding.EncodeToString(raw)
	b.mu.Lock()
	defer b.mu.Unlock()
	now := time.Now()
	for k, v := range b.m {
		if now.After(v.Exp) {
			delete(b.m, k)
		}
	}
	b.m[code] = rec
	return code, nil
}

func (b *BounceStore) Consume(code string) (bounceCode, bool) {
	b.mu.Lock()
	defer b.mu.Unlock()
	rec, ok := b.m[code]
	delete(b.m, code)
	if !ok || time.Now().After(rec.Exp) {
		return bounceCode{}, false
	}
	return rec, true
}
```

#### Start (user-authenticated)

```go
var providerIDRe = regexp.MustCompile(`^[A-Za-z0-9_-]{1,64}$`)

// POST /v1/bounce/start  {plane, purpose: "external-auth"|"terminal", provider?, workspace_id?}
// Redirect targets are computed here (never taken from the client) to avoid open redirects.
func (s *Service) handleBounceStart(w http.ResponseWriter, r *http.Request) {
	email := emailFromCtx(r.Context())
	var in struct {
		Plane       string `json:"plane"`
		Purpose     string `json:"purpose"`
		WorkspaceID string `json:"workspace_id"`
		Provider    string `json:"provider"`
	}
	if err := json.NewDecoder(io.LimitReader(r.Body, 8<<10)).Decode(&in); err != nil {
		http.Error(w, "invalid json", http.StatusBadRequest)
		return
	}
	p, err := s.plane(in.Plane)
	if err != nil {
		http.Error(w, err.Error(), http.StatusBadRequest)
		return
	}
	if !s.bounceTrustsPlane(p.ID) {
		http.Error(w, "bounce not configured for plane "+p.ID, http.StatusNotImplemented)
		return
	}

	var redirect string
	switch in.Purpose {
	case "external-auth":
		if !providerIDRe.MatchString(in.Provider) {
			http.Error(w, "invalid provider id", http.StatusBadRequest)
			return
		}
		// /callback without ?code starts Coder's OAuth redirect to the provider directly
		// (skips the "Login with …" button on Coder's page). After linking, Coder returns to
		// DonePath, where the bounce clears the cookie and revokes the bounce token.
		redirect = "/external-auth/" + in.Provider + "/callback?redirect=" + url.QueryEscape(s.Config.Bounce.DonePath)
	case "terminal": // optional: Coder's built-in web terminal (not needed with ttyd)
		tok, err := s.ensureCoderTokenOnPlane(r.Context(), email, p.ID)
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		raw, err := p.Client.WorkspaceRaw(r.Context(), tok, in.WorkspaceID)
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		me, err := p.Client.GetMe(r.Context(), tok)
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		name, _ := raw["name"].(string)
		agent := firstAgentName(raw)
		if name == "" || agent == "" {
			http.Error(w, "workspace has no agent yet", http.StatusConflict)
			return
		}
		redirect = fmt.Sprintf("/@%s/%s.%s/terminal",
			url.PathEscape(me.Username), url.PathEscape(name), url.PathEscape(agent))
	default:
		http.Error(w, "purpose must be terminal or external-auth", http.StatusBadRequest)
		return
	}

	ttl := time.Duration(s.Config.Bounce.CodeTTLSeconds) * time.Second
	code, err := s.Bounce.Issue(bounceCode{
		Email: email, Plane: p.ID, Redirect: redirect, Purpose: in.Purpose, Exp: time.Now().Add(ttl),
	})
	if err != nil {
		http.Error(w, "code issue failed", http.StatusInternalServerError)
		return
	}
	writeJSON(w, http.StatusOK, map[string]any{
		"bounce_url": strings.TrimRight(p.URL, "/") + s.Config.Bounce.Path,
		"code":       code,
		"method":     "POST",
		"expires_in": int(ttl.Seconds()),
		"plane_id":   p.ID,
	})
}

func (s *Service) bounceTrustsPlane(planeID string) bool {
	for _, c := range s.Config.Bounce.Callers {
		if c.Plane == planeID {
			return true
		}
	}
	return false
}
