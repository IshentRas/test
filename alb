python3 - <<'PY'
import os, errno, stat
p="/dev/net/tun"
st=os.stat(p)
print("POD  path ok", "mode", oct(st.st_mode), "rdev", os.major(st.st_rdev), os.minor(st.st_rdev))
try:
    fd=os.open(p, os.O_RDWR); print("POD  open_ok", fd); os.close(fd)
except OSError as e:
    print("POD  open_fail", e.errno, errno.errorcode.get(e.errno), e)
PY
podman unshare python3 - <<'PY'
import os, errno
p="/dev/net/tun"
print("UNSHARE exists", os.path.exists(p))
try:
    st=os.stat(p)
    print("UNSHARE mode", oct(st.st_mode), "rdev", os.major(st.st_rdev), os.minor(st.st_rdev))
