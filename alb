}

resource "aws_lb_target_group_attachment" "bounce" {
  target_group_arn = aws_lb_target_group.bounce.arn
  target_id        = aws_lambda_function.bounce.arn
  depends_on       = [aws_lambda_permission.alb]
}

# Highest priority on the plane's HTTPS listener; exact plane host only (not *.coder-a…).
resource "aws_lb_listener_rule" "bounce" {
  listener_arn = var.https_listener_arn
  priority     = 10

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.bounce.arn
