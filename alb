```

Build and package (runtime `provided.al2023`, arm64):

```bash
GOOS=linux GOARCH=arm64 go build -tags lambda.norpc -o bootstrap ./cmd/lambda
zip lambda.zip bootstrap
```

Environment: `MIDDLE_URL`, `MIDDLE_SERVER_ID` (= middle `bounce.server_id`), `STS_REGION`
(= region of middle's `sts_endpoint`), `COOKIE_SECURE=true`.

ALB ↔ Lambda facts the handler relies on:

- The ALB sends a JSON event (`httpMethod`, `path`, `queryStringParameters`, `headers` with lowercase
  names, `body`, `isBase64Encoded`) and adds `X-Forwarded-For/Port/Proto`. Query values arrive
  **still percent-encoded**. Form bodies (`application/x-www-form-urlencoded`) arrive base64-encoded.
- The response is `statusCode`, `statusDescription`, `headers`, optional `body`; `Set-Cookie` in
  `headers` is passed to the browser.
- Without multi-value headers the ALB keeps only the **last** value of a repeated request header
  and accepts one value per response header. With `lambda.multi_value_headers.enabled` it sends
  `multiValueHeaders` / `multiValueQueryStringParameters` and **requires** `multiValueHeaders` in
  the response. The handler supports both; enable it so `/done` always sees the full `Cookie`.
- Request and response bodies are limited to 1 MB; WebSockets are not supported (not needed).

### 6.4 Portal

Button (top bar):

```html
<button type="button" id="gitlabConnect" class="btn btn--ghost" title="Link GitLab for git clone/push in workspaces">
  <span class="btn-label">GitLab: checking…</span>
</button>
```

Logic (`api(path, opts)` is the portal's fetch wrapper: `MIDDLE_URL + path`, `Authorization: Bearer <IdP JWT>`,
JSON, throws on non-2xx):

```javascript
const GITLAB_PROVIDER = "primary-gitlab";

async function gitlabStatus(planeId = "") {
  const q = planeId ? `?plane=${encodeURIComponent(planeId)}` : "";
  return api(`/v1/external-auth/${GITLAB_PROVIDER}${q}`);
}

async function refreshGitLabStatus() {
  const btn = document.getElementById("gitlabConnect");
  if (!btn) return null;
  const label = btn.querySelector(".btn-label");
  try {
    const st = await gitlabStatus();
    label.textContent = st.authenticated ? `GitLab: linked${st.login ? ` (${st.login})` : ""}` : "Connect GitLab";
    btn.dataset.linked = st.authenticated ? "1" : "";
    return st;
  } catch {
    label.textContent = "GitLab: unavailable";
    return null;
  }
}

/**
 * Cookie-only Coder pages via the plane-host bounce: middle returns a one-time code; we POST it
 * to {plane}/_portal/bounce so it never appears in a URL.
 */
async function openViaBounce(body, { sameTab = false } = {}) {
  const w = sameTab ? window : window.open("about:blank", "_blank"); // open synchronously (popup blockers)
  if (!w) throw new Error("popup blocked — allow popups to open Coder pages");
  if (!sameTab) w.opener = null;
  try {
    const data = await api("/v1/bounce/start", { method: "POST", body: JSON.stringify(body) });
    const doc = w.document;
    const form = doc.createElement("form");
    form.method = "POST";
    form.action = data.bounce_url;
    const input = doc.createElement("input");
    input.type = "hidden";
    input.name = "code";
    input.value = data.code;
    form.appendChild(input);
    doc.body.appendChild(form);
    form.submit();
  } catch (e) {
    if (!sameTab) w.close();
    throw e;
  }
}

/**
 * Consent runs on the plane host (cookie-only page) via the bounce, in this tab. Coder then
 * redirects to {plane}/_portal/done, which revokes the bounce token, clears the cookie and
 * sends the browser back here with ?linked=1.
 */
async function connectGitLab(planeId = "") {
  await openViaBounce({ plane: planeId, purpose: "external-auth", provider: GITLAB_PROVIDER }, { sameTab: true });
}

async function disconnectGitLab(planeId = "") {
  const q = planeId ? `?plane=${encodeURIComponent(planeId)}` : "";
  await api(`/v1/external-auth/${GITLAB_PROVIDER}${q}`, { method: "DELETE" });
  return refreshGitLabStatus();
}

document.getElementById("gitlabConnect")?.addEventListener("click", async (ev) => {
  const btn = ev.currentTarget;
  try {
    if (btn.dataset.linked) {
      if (confirm("Disconnect GitLab from Coder?")) await disconnectGitLab();
      return;
    }
    await connectGitLab();
  } catch (e) {
    alert(String(e.message || e));
  }
});

if (new URLSearchParams(location.search).has("linked")) {
  history.replaceState(null, "", location.pathname);
}

// After login is shown: refreshGitLabStatus();
```

The portal's login must survive a same-tab round trip (store the IdP session in `localStorage`
or re-login silently); the return lands on `done_redirect`, so that must be the origin the user
logged in on.

