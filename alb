  server_id: "middle-prod"                      # audience the Lambda must sign
  sts_endpoint: "https://sts.us-east-1.amazonaws.com/"   # must match the Lambda's STS_REGION
  path: "/_portal/bounce"                       # default
  done_path: "/_portal/done"                    # default
  done_redirect: "https://portal.example.com/"  # default: first portal_origins entry
  code_ttl_seconds: 60                          # default
  cookie_max_age_seconds: 900                   # terminal purpose; external-auth uses 300
  callers:
    - plane: a
      account_id: "111122223333"
      role_name: "coder-bounce-a"
      role_id: "AROA…"                          # optional pin
