#### Caller verification (STS replay + allowlist)

```go
const stsGetCallerIdentityBody = "Action=GetCallerIdentity&Version=2011-06-15"

var forwardedSTSHeaders = []string{
	"authorization", "x-amz-date", "x-amz-security-token", "content-type",
	"x-middle-server-id", "x-middle-code-sha256",
}

// The signature is bound to sha256(action + "\n" + value) so a proof for one action
// ("redeem" with a code, "done" with a session token) can't be replayed for the other.
func (s *Service) verifyBounceCaller(ctx context.Context, proof iamProof, action, value string) (plane, arn string, err error) {
	cfg := s.Config.Bounce
	if cfg.ServerID == "" || len(cfg.Callers) == 0 {
		return "", "", errors.New("bounce not configured")
	}
	h := map[string]string{}
	for k, v := range proof.Headers {
		h[strings.ToLower(k)] = v
	}
	if h["x-middle-server-id"] != cfg.ServerID {
		return "", "", errors.New("audience mismatch")
	}
	sum := sha256.Sum256([]byte(action + "\n" + value))
	if h["x-middle-code-sha256"] != hex.EncodeToString(sum[:]) {
		return "", "", errors.New("signature not bound to this request")
	}
	signed := signedHeaderSet(h["authorization"])
	if !signed["x-middle-server-id"] || !signed["x-middle-code-sha256"] {
		return "", "", errors.New("audience/code headers not signed")
	}
	body, err := base64.StdEncoding.DecodeString(proof.Body)
	if err != nil || string(body) != stsGetCallerIdentityBody {
		return "", "", errors.New("unexpected STS action")
	}

	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, cfg.STSEndpoint, bytes.NewReader(body))
	if err != nil {
		return "", "", err
	}
	for _, k := range forwardedSTSHeaders {
		if v := h[k]; v != "" {
			req.Header.Set(k, v)
		}
	}
	res, err := http.DefaultClient.Do(req)
	if err != nil {
		return "", "", fmt.Errorf("sts: %w", err)
	}
	defer res.Body.Close()
	raw, _ := io.ReadAll(io.LimitReader(res.Body, 64<<10))
	if res.StatusCode != http.StatusOK {
		return "", "", fmt.Errorf("sts rejected signature (%d)", res.StatusCode)
	}
	var out struct {
		Result struct {
			Arn     string `xml:"Arn"`
			UserID  string `xml:"UserId"`
			Account string `xml:"Account"`
		} `xml:"GetCallerIdentityResult"`
	}
	if err := xml.Unmarshal(raw, &out); err != nil {
		return "", "", fmt.Errorf("sts response: %w", err)
	}
	arn = out.Result.Arn
	// arn:aws:sts::<acct>:assumed-role/<role-name>/<session>  (role path is not included)
	fields := strings.SplitN(arn, ":", 6)
	if len(fields) != 6 {
		return "", arn, errors.New("unexpected arn")
	}
	parts := strings.Split(fields[5], "/")
	if len(parts) < 3 || parts[0] != "assumed-role" {
		return "", arn, errors.New("caller is not an assumed role")
	}
	roleID := strings.SplitN(out.Result.UserID, ":", 2)[0]
	for _, c := range cfg.Callers {
		if c.AccountID == out.Result.Account && c.RoleName == parts[1] &&
			(c.RoleID == "" || c.RoleID == roleID) {
			return c.Plane, arn, nil
		}
	}
	return "", arn, fmt.Errorf("role %s not in allowlist", arn)
}

func signedHeaderSet(authz string) map[string]bool {
	out := map[string]bool{}
	i := strings.Index(authz, "SignedHeaders=")
	if i < 0 {
		return out
	}
	rest := authz[i+len("SignedHeaders="):]
	if j := strings.IndexAny(rest, ", "); j >= 0 {
		rest = rest[:j]
	}
	for _, name := range strings.Split(rest, ";") {
		out[strings.ToLower(name)] = true
	}
	return out
}
