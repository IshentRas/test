// EnsureReservedUserTokenLifetime deletes any existing key with this name, then mints a fresh one.
func (c *CoderClient) EnsureReservedUserTokenLifetime(ctx context.Context, userID, name string, lifetime time.Duration) (string, error) {
	keys, err := c.ListUserAPIKeys(ctx, userID) // GET /api/v2/users/{id}/keys/tokens (owner token)
	if err != nil {
		return "", err
	}
	for _, k := range keys {
		if k.TokenName == name {
			if err := c.DeleteUserAPIKey(ctx, userID, k.ID); err != nil {
				return "", err
			}
		}
	}
	body := map[string]any{"token_name": name, "lifetime": int64(lifetime)} // Coder expects nanoseconds
	var resp struct {
		Key string `json:"key"`
	}
	if err := c.do(ctx, http.MethodPost, "/api/v2/users/"+userID+"/keys/tokens", c.OwnerToken, body, &resp); err != nil {
		return "", err
	}
	if resp.Key == "" {
		return "", fmt.Errorf("empty token key from coder")
	}
	return resp.Key, nil
}
