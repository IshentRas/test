// Called by the bounce at DonePath after Coder finishes external auth. Revokes the cookie's
// token only if it is this plane's bounce key, and returns where to send the browser.
func (s *Service) handleBounceDone(w http.ResponseWriter, r *http.Request) {
	var in struct {
		Host         string   `json:"host"`
		SessionToken string   `json:"session_token"`
		IAM          iamProof `json:"iam"`
	}
	if err := json.NewDecoder(io.LimitReader(r.Body, 64<<10)).Decode(&in); err != nil {
		http.Error(w, "invalid request", http.StatusBadRequest)
		return
	}
	callerPlane, callerARN, err := s.verifyBounceCaller(r.Context(), in.IAM, "done", in.SessionToken)
	if err != nil {
		log.Printf("bounce done rejected caller: %v", err)
		http.Error(w, "caller not trusted", http.StatusForbidden)
		return
	}
	p, err := s.plane(callerPlane)
	if err != nil {
		http.Error(w, err.Error(), http.StatusBadRequest)
		return
	}
	host := in.Host
	if h, _, err := net.SplitHostPort(host); err == nil {
		host = h
	}
	if !strings.EqualFold(host, cookieHostForURL(p.URL)) {
		http.Error(w, "host mismatch", http.StatusForbidden)
		return
	}
	revoked := false
	if keyID, _, ok := strings.Cut(in.SessionToken, "-"); ok && keyID != "" {
		if me, err := p.Client.GetMe(r.Context(), in.SessionToken); err == nil {
			keys, _ := p.Client.ListUserAPIKeys(r.Context(), me.ID)
			for _, k := range keys {
				if k.ID == keyID && k.TokenName == bounceTokenName(p.ID) {
					revoked = p.Client.DeleteUserAPIKey(r.Context(), me.ID, k.ID) == nil
				}
			}
			log.Printf("bounce done user=%s plane=%s revoked=%v caller=%s", me.Username, p.ID, revoked, callerARN)
		}
	}
	writeJSON(w, http.StatusOK, map[string]any{
		"redirect_url": s.Config.Bounce.DoneRedirect,
		"revoked":      revoked,
	})
}
