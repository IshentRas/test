## 3. Seccomp profile

Generate from moby's default profile, resolved for a container with no capabilities, plus the overlay syscalls. Pin the moby URL to a commit for production.

```python
#!/usr/bin/env python3
# gen-seccomp.py > overlay-userns.json          (production)
# gen-seccomp.py --debug > overlay-userns-debug.json   (+ setns for nsenter from kubectl exec)
import copy, json, sys, urllib.request

URL = "https://raw.githubusercontent.com/moby/profiles/main/seccomp/default.json"
ARCHES = {"amd64", "arm64", "x86", "x32"}
EXTRA = ["unshare", "mount", "umount2", "fsopen", "fsconfig", "fsmount", "move_mount"]
if "--debug" in sys.argv:
    EXTRA.append("setns")

profile = json.load(urllib.request.urlopen(URL))
rules = []
for rule in profile["syscalls"]:
    inc, exc = rule.get("includes", {}), rule.get("excludes", {})
    if inc.get("caps"):
        continue                                    # needs a capability the pod does not have
    if inc.get("arches") and not set(inc["arches"]) & ARCHES:
        continue                                    # other architectures only
    if exc.get("arches") and set(exc["arches"]) >= ARCHES:
        continue
    rule = copy.deepcopy(rule)
    rule.pop("includes", None)
    rule.pop("excludes", None)
    rules.append(rule)
rules.append({"names": EXTRA, "action": "SCMP_ACT_ALLOW"})
profile["syscalls"] = rules
json.dump(profile, sys.stdout, indent=2)
```

The 7-syscall list covers both `fuse-overlayfs` and kernel overlay with either util-linux version. Drop `fsopen`/`fsconfig`/`fsmount`/`move_mount` if you only use `fuse-overlayfs`.

