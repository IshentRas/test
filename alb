  - id: a
    url: "https://coder-a.example.com"          # public; also the cookie host
    api_url: "http://coder-a.internal:3000"     # optional: middle → Coder API over a private URL
    owner_token: "…"                            # Coder owner token (mints user keys)

portal_origins:
  - "https://portal.example.com"

