}

async function showOutput(title: string, text: string): Promise<void> {
  await showDialog({ title, body: outputBody(text), buttons: [Dialog.okButton({ label: 'Close' })] });
}

/** The line worth putting in a notification: "ok share ref=..." for ws-publish, else the last line. */
function summary(output: string): string {
  const lines = output.split('\n').map(l => l.trim()).filter(Boolean);
  return lines.find(l => l.startsWith('ok ')) ?? lines[lines.length - 1] ?? '';
}

/** POST /ws-actions/run/<action>, with an in-progress notification that turns into the result. */
async function run(action: string, title: string, payload: object = {}): Promise<IResult | null> {
  const id = Notification.emit(`${title}…`, 'in-progress', { autoClose: false });
  try {
    const res = await requestAPI<IResult>(`run/${action}`, {
      method: 'POST',
      body: JSON.stringify(payload)
    });
    Notification.update({
      id,
      message: `${title}: ${summary(res.output) || (res.ok ? 'done' : 'failed')}`,
      type: res.ok ? 'success' : 'error',
      autoClose: res.ok ? 6000 : false,
      actions: [{ label: 'Details', callback: () => void showOutput(title, res.output) }]
    });
    return res;
  } catch (e) {
    Notification.update({ id, message: `${title} failed: ${(e as Error).message}`, type: 'error', autoClose: 8000 });
    return null;
  }
}

/** Promote from the current changes, or from an existing share tag. */
class PromoteBody extends Widget {
  private source = document.createElement('select');
  private tag = document.createElement('input');

  constructor() {
    super();
    const sourceLabel = document.createElement('label');
    sourceLabel.textContent = 'Promote';
    this.source.add(new Option('My current changes', 'changes'));
    this.source.add(new Option('An existing share tag', 'tag'));
    this.tag.placeholder = 'ws/<user>/<yyyymmdd-hhmmss>';
    this.tag.disabled = true;
    this.source.onchange = () => {
      this.tag.disabled = this.source.value !== 'tag';
      if (!this.tag.disabled) {
        this.tag.focus();
      }
    };
    for (const el of [this.source, this.tag]) {
      el.className = 'jp-mod-styled jp-WsActions-field';
    }
    this.node.append(sourceLabel, this.source, this.tag);
  }

  getValue(): { from_tag?: string } {
    return this.source.value === 'tag' ? { from_tag: this.tag.value.trim() } : {};
  }
}

const plugin: JupyterFrontEndPlugin<void> = {
  id: 'ws-actions:plugin',
  description: 'Workspace menu: share, promote and rebase the overlay workspace.',
  autoStart: true,
  requires: [IDefaultFileBrowser],
  activate: (app: JupyterFrontEnd, browser: IDefaultFileBrowser) => {
    /** After the lower layer changed: refresh the listing and tell the user about open files. */
    const afterBaseSwitch = async (res: IResult | null) => {
      if (res?.ok) {
        await browser.model.refresh();
        Notification.info('Reload open files and restart kernels to see the new base.', { autoClose: 8000 });
      }
    };

    app.commands.addCommand(CMD.status, {
      label: 'Workspace status',
      icon: listIcon,
      execute: async () => {
        const res = await run('status', 'Workspace status');
        if (res) {
          await showOutput('Workspace status', res.output);
        }
      }
    });

    app.commands.addCommand(CMD.share, {
      label: 'Share a snapshot…',
      caption: 'Commit all your changes on the current base and push them as a ws/<user>/<time> tag',
      icon: shareIcon,
      execute: async () => {
        const result = await showDialog({
          title: 'Share a snapshot',
          body: 'Commit all your changes on top of the current base and push them as a tag ws/<you>/<time>?',
          buttons: [Dialog.cancelButton(), Dialog.okButton({ label: 'Share' })]
        });
        if (result.button.accept) {
          await run('share', 'Share');
        }
      }
    });

    app.commands.addCommand(CMD.promote, {
      label: 'Promote…',
      caption: 'Push your changes (or a share tag) as a ws/<user>/<time> branch for a merge request',
      icon: moveUpIcon,
      execute: async () => {
        const result = await showDialog<{ from_tag?: string }>({
          title: 'Promote',
          body: new PromoteBody(),
          buttons: [Dialog.cancelButton(), Dialog.okButton({ label: 'Promote' })]
        });
        if (!result.button.accept || !result.value) {
          return;
        }
        if (result.value.from_tag === '') {
          Notification.warning('Enter the share tag to promote.', { autoClose: 5000 });
          return;
        }
        await run('promote', 'Promote', result.value);
      }
    });

    app.commands.addCommand(CMD.rebase, {
      label: 'Update to latest…',
      caption: 'Move your workspace onto the latest commit, keeping your changes',
      icon: refreshIcon,
      execute: async () => {
        const check = await run('check', 'Checking for conflicts');
        if (!check?.ok) {
          return;
        }
        const clean = check.output.startsWith('no conflicts');
        const result = await showDialog({
          title: 'Update to latest',
          body: clean
            ? 'No conflicts. Move your workspace onto the latest commit? Your changes are kept.'
            : outputBody(
                'Upstream also changed these files. Updating keeps YOUR copy and hides their change:\n\n' +
                  check.output
              ),
          buttons: [
            Dialog.cancelButton(),
            clean ? Dialog.okButton({ label: 'Update' }) : Dialog.warnButton({ label: 'Update anyway' })
          ]
        });
        if (result.button.accept) {
          await afterBaseSwitch(await run('rebase', 'Update to latest', { force: !clean }));
        }
      }
    });

    app.commands.addCommand(CMD.back, {
      label: 'Go back to previous base…',
      caption: 'Return to the commit you were on before the last update',
      icon: undoIcon,
      execute: async () => {
        const confirm = await showDialog({
          title: 'Go back',
          body: 'Move your workspace back to the previous base commit? Your changes are kept.',
          buttons: [Dialog.cancelButton(), Dialog.okButton({ label: 'Go back' })]
        });
        if (!confirm.button.accept) {
          return;
        }
        let res = await run('back', 'Go back');
        if (res && !res.ok && res.output.startsWith('refused')) {
          const force = await showDialog({
            title: 'Go back anyway?',
            body: outputBody(res.output),
            buttons: [Dialog.cancelButton(), Dialog.warnButton({ label: 'Go back anyway' })]
          });
          if (!force.button.accept) {
            return;
          }
          res = await run('back', 'Go back', { force: true });
        }
        await afterBaseSwitch(res);
      }
    });

    const menu = new Menu({ commands: app.commands });
    menu.title.label = 'Workspace';
    menu.addItem({ command: CMD.status });
    menu.addItem({ type: 'separator' });
    menu.addItem({ command: CMD.share });
    menu.addItem({ command: CMD.promote });
    menu.addItem({ type: 'separator' });
    menu.addItem({ command: CMD.rebase });
    menu.addItem({ command: CMD.back });

    app.commands.addCommand(CMD.menu, {
      label: args => (args.toolbar ? '' : 'Workspace actions'),
      caption: 'Share, promote or update your workspace',
      icon: workspaceIcon,
      execute: () => {
        const button = document.querySelector(`.jp-FileBrowser [data-command="${CMD.menu}"]`);
        const r = button?.getBoundingClientRect();
        menu.open(r ? r.left : window.innerWidth / 2, r ? r.bottom : window.innerHeight / 3);
      }
    });
  }
};

export default plugin;
EOF
```

