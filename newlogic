# UBI 9 variant of the POC desktop image: XFCE from EPEL + Chromium + VS Code GUI + JupyterLab.
# Local check uses the public EPEL release RPM; in the org, point dnf at the internal EPEL mirror instead.
#   docker build -f Dockerfile.ubi -t coder-kasm-desktop:ubi .
FROM registry.access.redhat.com/ubi9/ubi

# EPEL provides XFCE (and xrdp) on RHEL/UBI 9; Red Hat repos do not ship XFCE.
# Plain UBI's AppStream is a subset: XFCE also needs desktop libs (gvfs, libnotify, ...)
# that live in full AppStream/CRB. LOCAL CHECK ONLY: CentOS Stream repos stand in for
# them; in the org, build on a subscribed RHEL 9 builder / Satellite (AppStream + CRB
# enabled) and delete the centos-stream.repo block below.
# Note: no full `curl` package below — UBI ships curl-minimal, which conflicts with it.
RUN dnf -y install \
      https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
 && printf '[cs-baseos]\nname=CentOS Stream 9 BaseOS (local check)\nbaseurl=https://mirror.stream.centos.org/9-stream/BaseOS/$basearch/os/\ngpgcheck=0\n[cs-appstream]\nname=CentOS Stream 9 AppStream (local check)\nbaseurl=https://mirror.stream.centos.org/9-stream/AppStream/$basearch/os/\ngpgcheck=0\n[cs-crb]\nname=CentOS Stream 9 CRB (local check)\nbaseurl=https://mirror.stream.centos.org/9-stream/CRB/$basearch/os/\ngpgcheck=0\n' \
      > /etc/yum.repos.d/centos-stream.repo \
 && dnf -y groupinstall "Xfce" \
 && dnf -y install \
      xfce4-terminal dbus-x11 xorg-x11-xinit \
      chromium \
      python3.11 python3.11-pip \
      git sudo procps-ng ca-certificates dejavu-sans-fonts \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# VS Code GUI from the Microsoft yum repo (key imported explicitly; the repo stays enabled
# here because, unlike the Debian .deb, the RPM registers its key correctly — verify with
# `dnf repolist` / a later `dnf update` in CI).
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc \
 && printf '[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc\n' \
      > /etc/yum.repos.d/vscode.repo \
 && dnf -y install code \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# JupyterLab in its own venv (outside /home/coder so the home volume cannot hide it).
RUN python3.11 -m venv /opt/jupyter \
 && /opt/jupyter/bin/pip install --no-cache-dir jupyterlab

# KasmVNC server: not in EPEL. Use the EL9-family RPM from Kasm's GitHub releases
# (verified: installs cleanly on UBI 9.8). Baking it in also matters because the Coder
# kasmvnc module does not recognise ID=rhel — but it skips its install step when
# `kasmvncserver` is already on PATH. The RPM names the launcher `vncserver`,
# so add the `kasmvncserver` symlink the module checks for and launches — in
# /usr/bin, because the script looks for the Xvnc binary next to itself.
# The www chown: for path apps (subdomain=false) the module patches the Kasm web
# root at startup (path_vnc.html); without sudo that write must be coder-owned.
RUN dnf -y install \
      "https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0/kasmvncserver_oracle_9_1.5.0_$(uname -m).rpm" \
 && ln -s /usr/bin/vncserver /usr/bin/kasmvncserver \
 && chown -R 1000:1000 /usr/share/kasmvnc/www \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# No sudo grant for the workspace user: KasmVNC is preinstalled above, so the
# kasmvnc module skips the only step that needed sudo and uses $HOME/.vnc config.
# VERSION_CODENAME: the module's run.sh sources /etc/os-release under `set -u`
# and reads $VERSION_CODENAME, which UBI does not define — without this line the
# script dies before it even checks whether KasmVNC is installed.
RUN useradd -m -s /bin/bash coder \
 && echo 'VERSION_CODENAME=""' >> /etc/os-release

# Desktop launchers + wrapper scripts (see Dockerfile for the Debian variant); the template's
# startup script copies them into ~/Desktop on every start.
COPY launch-jupyter launch-vscode JupyterLab.desktop VSCode.desktop jupyter.svg /usr/local/share/poc/
RUN chmod +x /usr/local/share/poc/launch-jupyter /usr/local/share/poc/launch-vscode

USER coder
WORKDIR /home/coder
